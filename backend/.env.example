NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://flowdesk:flowdesk@localhost:5433/flowdesk?schema=public
# Browser origins allowed by CORS (comma-separated)
FRONTEND_URLS=http://localhost:3005
# Public frontend URL, used for links in emails
APP_URL=http://localhost:3005
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60
INVITE_TTL_HOURS=72
COOKIE_DOMAIN=

# SMTP. In development, Mailpit (docker compose) catches every email:
# open http://localhost:8025 to read them.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Flowdesk <no-reply@flowdesk.local>
