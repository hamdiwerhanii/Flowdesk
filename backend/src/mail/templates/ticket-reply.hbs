{{> header}}
<p>Hi {{name}},</p>
<p><strong>{{authorName}}</strong> replied to a ticket in {{organizationName}}.</p>
<p style="background:#f6f7fb;border-radius:8px;padding:12px 14px;margin:16px 0;">
  <span style="color:#6b7280;font-family:monospace;">#{{number}}</span> <strong>{{subject}}</strong>
</p>
<blockquote style="margin:16px 0;padding:4px 0 4px 14px;border-left:3px solid #c7d2fe;color:#374151;white-space:pre-wrap;">{{body}}</blockquote>
<p style="margin:28px 0;">
  <a href="{{url}}" style="background:#4f46e5;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:8px;font-weight:600;display:inline-block;">Reply</a>
</p>
<p style="color:#6b7280;font-size:13px;">If the button doesn't work, copy this link into your browser:<br /><a href="{{url}}" style="color:#4f46e5;word-break:break-all;">{{url}}</a></p>
{{> footer}}
